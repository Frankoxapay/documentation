            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/architecture",
              "concepts/owner-app",
              "concepts/address-bank",
              "concepts/payments",
              "concepts/payment-states",
              "concepts/webhooks",
              "concepts/collect",
              "concepts/security",
              "concepts/billing"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "../openapi/openapi.docs.yaml",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/overview", "api-reference/payment-webhook"]
